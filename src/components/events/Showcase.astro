---
// Proyectos destacados de un evento (DESIGN §5.2, design/Eventos.dc.html #destacados).
// Solo se renderiza con un layout no nulo: `showcaseLayout` ya decidió que la vitrina está completa.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ShowcaseLayout } from '../../lib/showcase';
import Button from '../Button.astro';
import Cross from '../Cross.astro';
import '../../styles/showcase.css';
import '../../styles/tabs.css';

export type ShowcaseItem = {
  title: string;
  team: string;
  members: string[];
  problem: string;
  stack: string[];
  demoUrl?: string | undefined;
  repoUrl?: string | undefined;
  shotDesktop: ImageMetadata;
  shotMobile?: ImageMetadata | undefined;
};

interface Props {
  eventTitle: string;
  layout: ShowcaseLayout<ShowcaseItem>;
}

const { eventTitle, layout } = Astro.props;
const { hero, cards, rows } = layout;
const host = (url?: string) => (url ? new URL(url).host : 'sin demo pública');
---

<section id="destacados" class="pb-showcase">
  <div class="pb-showcase__bg" aria-hidden="true"><div class="pb-grain"></div></div>
  <div class="pb-container pb-showcase__wrap">
    <div class="pb-showcase__bar">
      <h2>Proyectos destacados</h2>
      <span class="pb-showcase__event">{eventTitle}</span>
    </div>
    <p class="pb-showcase__lead">Lo que construyeron nuestros equipos, publicado para que cualquiera lo pruebe.</p>

    <article class="pb-feat" data-shot-toggle>
      <div class="pb-featL">
        {
          hero.shotMobile && (
            <div role="group" aria-label="Vista previa" class="pb-tabs">
              <button type="button" class="pb-tab" aria-pressed="true" data-shot="desk">Escritorio</button>
              <button type="button" class="pb-tab" aria-pressed="false" data-shot="mob">Móvil</button>
            </div>
          )
        }
        <div class="pb-stage">
          <div class="pb-browser" data-view="desk">
            <div class="pb-bbar" aria-hidden="true">
              <span class="pb-sq"></span><span class="pb-sq"></span><span class="pb-sq"></span>
              <span class="pb-bbar__url">{host(hero.demoUrl)}</span>
            </div>
            <Image class="pb-shot" src={hero.shotDesktop} alt={`Captura de escritorio de ${hero.title}`} widths={[640, 960]} sizes="(max-width: 960px) 100vw, 720px" />
          </div>
          {
            hero.shotMobile && (
              <div class="pb-phone" data-view="mob" hidden>
                <span class="pb-notch" aria-hidden="true" />
                <Image class="pb-shot" src={hero.shotMobile} alt={`Captura móvil de ${hero.title}`} width={320} />
              </div>
            )
          }
        </div>
      </div>
      <div class="pb-featR">
        <span class="pb-featR__eyebrow"><span class="pb-dot" aria-hidden="true"></span>destacado</span>
        <h3 class="pb-feat__title">{hero.title}</h3>
        <div class="pb-pair">
          <span class="pb-tag">{hero.team}</span><span class="pb-pair__line" aria-hidden="true"></span><span class="pb-tag pill">{hero.members.join(', ')}</span>
        </div>
        <div class="pb-feat__problem">
          <span>qué resuelve</span>
          <p>{hero.problem}</p>
        </div>
        <ul class="pb-stack">{hero.stack.map((t) => <li class="pb-tech">{t}</li>)}</ul>
        <div class="pb-actions">
          {hero.demoUrl && <Button variant="primary" href={hero.demoUrl} external>Ver demo</Button>}
          {hero.repoUrl && <Button variant="secondary" href={hero.repoUrl} external>Código</Button>}
        </div>
      </div>
    </article>

    {
      cards.length > 0 && (
        <div class="pb-pgrid2">
          {cards.map((p) => (
            <article class="pb-pcard">
              <div class="pb-browser">
                <div class="pb-bbar" aria-hidden="true">
                  <span class="pb-sq" /><span class="pb-sq" /><span class="pb-sq" />
                  <span class="pb-bbar__url">{host(p.demoUrl)}</span>
                </div>
                <Image class="pb-shot" src={p.shotDesktop} alt={`Captura de ${p.title}`} widths={[480, 720]} sizes="(max-width: 960px) 100vw, 640px" loading="lazy" />
              </div>
              <div class="pb-pcardb">
                <h3 class="pb-pcard__title">{p.title}</h3>
                <span class="pb-meta">{p.team} · {p.members.join(', ')}</span>
                <p>{p.problem}</p>
                <ul class="pb-stack">{p.stack.map((t) => <li class="pb-tech">{t}</li>)}</ul>
                <div class="pb-actions">
                  {p.demoUrl && <Button variant="primary" size="sm" href={p.demoUrl} external>Ver demo</Button>}
                  {p.repoUrl && <Button variant="secondary" size="sm" href={p.repoUrl} external>Código</Button>}
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }

    {
      rows.length > 0 && (
        <div class="pb-more">
          <h3>Más proyectos del evento</h3>
          <div class="pb-plist">
            <Cross x="0" y="0" />
            <Cross x="100%" y="0" />
            {rows.map((p) => (
              <div class="pb-prow">
                <div class="pb-pn">
                  <span class="pb-pn__title">{p.title}</span>
                  <span class="pb-meta">{p.team}</span>
                </div>
                <ul class="pb-stack">{p.stack.map((t) => <li class="pb-tech">{t}</li>)}</ul>
                <div class="pb-actions">
                  {p.demoUrl && <Button variant="primary" size="sm" href={p.demoUrl} external>Ver demo</Button>}
                  {p.repoUrl && <Button variant="secondary" size="sm" href={p.repoUrl} external>Código</Button>}
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  import { initShotToggle } from '../../scripts/shot-toggle';
  document.querySelectorAll<HTMLElement>('[data-shot-toggle]').forEach(initShotToggle);
</script>
