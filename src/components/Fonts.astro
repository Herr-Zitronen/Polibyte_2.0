---
// Fuentes de DESIGN.md §2.2, servidas desde el propio dominio (Fontsource), con font-display: swap.
// Sin conexiones a terceros: Google Fonts añadía DNS + TLS a dos orígenes antes del primer pintado
// y Lighthouse (4G simulado) subía el FCP/LCP de Inicio a ~2,3 s (H4.1).
// unicode-range: el navegador solo descarga los subconjuntos que usa la página.
// WOR-101: se precarga el subconjunto latín de JetBrains Mono (el del titular, que es el LCP) y, mientras
// llega, se usa un respaldo monoespaciado con las métricas de JetBrains Mono (ancho 0,6 em, ascenso 1,02,
// descenso 0,30): al cambiar de fuente el h1 no se mueve (sin CLS).
// JetBrains Mono se declara aquí a mano, solo latín y latín extendido: la hoja completa de Fontsource añadía
// cirílico, griego y vietnamita (5 reglas de más en cada página) y el más pequeño, de 2 KB, acababa incrustado
// en base64 dentro del HTML. Los rangos son los de Fontsource; el sitio no usa ningún carácter de los otros.
import '@fontsource/silkscreen/latin-400.css';
import '@fontsource/silkscreen/latin-700.css';
import '@fontsource/instrument-sans/latin-600.css';
import jetbrainsLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
---

<link rel="preload" href={jetbrainsLatin} as="font" type="font/woff2" crossorigin />
<style is:global>
  @font-face {
    font-family: 'JetBrains Mono Variable';
    font-style: normal;
    font-display: swap;
    font-weight: 100 800;
    src: url('../../node_modules/@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-ext-wght-normal.woff2') format('woff2-variations');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'JetBrains Mono Variable';
    font-style: normal;
    font-display: swap;
    font-weight: 100 800;
    src: url('../../node_modules/@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2') format('woff2-variations');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* Courier New / Liberation Mono / Cousine avanzan 1229/2048 ≈ 0,6 em, igual que JetBrains Mono. */
  @font-face {
    font-family: 'JetBrains Mono Fallback';
    src: local('Courier New'), local('Liberation Mono'), local('Cousine'), local('Menlo');
    size-adjust: 100%;
    ascent-override: 102%;
    descent-override: 30%;
    line-gap-override: 0%;
  }
</style>
