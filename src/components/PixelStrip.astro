---
// Franja de píxeles: la lógica vive en src/lib/pixel-strip.ts; aquí solo se imprime.
import { pixelStrip } from '../lib/pixel-strip';
import '../styles/pixel-strip.css';

interface Props {
  seed: number;
  top: string;
  bottom: string;
}

const { seed, top, bottom } = Astro.props;
---

<div class="pb-div" aria-hidden="true" data-seed={seed} set:html={pixelStrip({ seed, top, bottom })} />
