---
// 404 (H9.2, design/NoEncontrado.dc.html). Cloudflare la sirve con estado 404 gracias a
// `not_found_handling: "404-page"` en wrangler.jsonc.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import GlassBackground from '../components/GlassBackground.astro';
import '../styles/not-found.css';
---

<Base title="Página no encontrada · PoliByte" description="Esta página no existe." noindex>
  <main>
    <section id="top" class="pb-glass pb-nf" data-bg>
      <GlassBackground image="hero" parallax="root" />
      <div class="pb-content pb-container pb-nf__in">
        <div class="pb-404" aria-hidden="true">404</div>
        <span class="pb-nf__bin" aria-hidden="true">110010100</span>
        <h1 class="pb-nf__h1">Esta página no existe.</h1>
        <p class="pb-nf__p">Puede que el enlace esté roto o que el contenido ya no esté publicado.</p>
        <div class="pb-nf__actions">
          <Button variant="primary" href="/">Volver al inicio</Button>
          <Button variant="secondary" href="/eventos/">Ver eventos</Button>
        </div>
      </div>
    </section>
  </main>
</Base>
