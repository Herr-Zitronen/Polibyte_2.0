---
// /unirme/ · H8.1. La URL del formulario vive en site.json (cambiarla no toca código).
import Base from '../../layouts/Base.astro';
import JoinForm from '../../components/join/JoinForm.astro';
import JoinSteps from '../../components/join/JoinSteps.astro';
import PixelStrip from '../../components/PixelStrip.astro';
import site from '../../content/site.json';
---

<Base title="Unirme · PoliByte" description="Cómo ser parte de PoliByte: formulario de ingreso, grupo y primera reunión presencial.">
  <main>
    <JoinForm formUrl={site.joinFormUrl} />
    <PixelStrip seed={151} top="#1B2C78" bottom="#ECEFF6" />
    <JoinSteps formUrl={site.joinFormUrl} />
    <PixelStrip seed={163} top="#ECEFF6" bottom="#0D1438" />
  </main>
</Base>
