---
// Inicio: portada (H4.1), panel del próximo evento (H4.2) y Qué hacemos (H4.3). Próximos eventos (H4.4).
import { getCollection } from 'astro:content';
import HeaderChip from '../components/HeaderChip.astro';
import JoinCta from '../components/home/JoinCta.astro';
import Hero from '../components/home/Hero.astro';
import NextEvent from '../components/home/NextEvent.astro';
import UpcomingEvents from '../components/home/UpcomingEvents.astro';
import WhatWeDo from '../components/home/WhatWeDo.astro';
import Base from '../layouts/Base.astro';
import { nextEvent } from '../lib/events';
import { upcomingRows } from '../lib/upcoming';

const events = (await getCollection('events')).map((e) => ({ ...e.data, id: e.id }));
const rows = upcomingRows(events, new Date());
const next = nextEvent(events, new Date()) as ((typeof events)[number] & { date: Date }) | undefined;
---

<Base title="PoliByte · Club de la Carrera de Software">
  {next && <HeaderChip slot="chip" title={next.title} date={next.date} time={next.time} />}
  <main>
    <Hero>
      <NextEvent event={next} />
    </Hero>
    <WhatWeDo />
    <UpcomingEvents rows={rows} />
    <JoinCta />
  </main>
</Base>
