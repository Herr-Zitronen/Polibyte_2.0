---
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { assertContentIntegrity } from '../content/integrity';
import '../styles/global.css';
import '../styles/transitions.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Las páginas de laboratorio lo apagan para que sus capturas no dependan de la barra. */
  header?: boolean;
}

await assertContentIntegrity();

const { title, description = 'PoliByte · Club de la Carrera de Software (ESPOCH)', noindex = false, header = true } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <Fonts />
  </head>
  <body>
    {
      header && (
        <Header>
          <slot name="chip" slot="chip" />
        </Header>
      )
    }
    {header && <MobileMenu />}
    <slot />
    {header && <Footer />}
    <script>
      import { initLenis } from '../scripts/lenis';
      void initLenis();
    </script>
  </body>
</html>
