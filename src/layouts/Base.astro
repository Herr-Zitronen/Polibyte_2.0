---
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import { assertContentIntegrity } from '../content/integrity';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Las páginas de laboratorio lo apagan para que sus capturas no dependan de la barra. */
  header?: boolean;
}

await assertContentIntegrity();

const { title, description = 'PoliByte · Club de la Carrera de Software (ESPOCH)', noindex = false, header = true } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <Fonts />
  </head>
  <body>
    {header && <Header />}
    <slot />
  </body>
</html>
