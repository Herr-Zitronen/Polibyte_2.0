---
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { assertContentIntegrity } from '../content/integrity';
import '../styles/global.css';
import '../styles/glass.css';
import '../styles/transitions.css';
// `?url` pasa por el mismo pipeline de Vite que los `url()` del CSS: misma ruta con hash, sin doble descarga.
import heroBg from '../assets/backgrounds/chimborazo-hero.webp?url';
import joinBg from '../assets/backgrounds/chimborazo-join.webp?url';
import recapBg from '../assets/backgrounds/chimborazo-recap.webp?url';

const COVERS = { hero: heroBg, join: joinBg, recap: recapBg } as const;

interface Props {
  title: string;
  /** Fondo de la portada de la página: se precarga para que no aparezca a media transición. */
  cover?: keyof typeof COVERS;
  description?: string;
  noindex?: boolean;
  /** Las páginas de laboratorio lo apagan para que sus capturas no dependan de la barra. */
  header?: boolean;
}

await assertContentIntegrity();

const { title, cover, description = 'PoliByte · Club de la Carrera de Software (ESPOCH)', noindex = false, header = true } = Astro.props;
// Prerender de la página siguiente (Chromium): la transición arranca con ella ya renderizada. Fuera /lab/.
// perf/fluidez-real: 'conservative' pre-renderiza al pulsar el enlace, no al dejar el cursor encima (con
// 'moderate' se pre-renderizaba una página entera en mitad del scroll si el puntero caía sobre un enlace).
const speculation = JSON.stringify({
  prerender: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/lab/*' } }] }, eagerness: 'conservative' }],
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <Fonts />
    {cover && <link rel="preload" as="image" href={COVERS[cover]} />}
    {header && <script type="speculationrules" is:inline set:html={speculation} />}
    {/* F12: una página pre-renderizada no corre sus animaciones de entrada hasta que se muestra. */}
    <script is:inline>
      if (document.prerendering) {
        document.documentElement.classList.add('pb-prerender');
        document.addEventListener('prerenderingchange', () => document.documentElement.classList.remove('pb-prerender'), { once: true });
      }
      // PR C: si se llega por una transición de vista, la barra no repite su entrada (sigue quieta en pantalla).
      addEventListener('pagereveal', (e) => {
        if (e.viewTransition) document.documentElement.classList.add('pb-vt-nav');
      });
    </script>
  </head>
  <body>
    {
      header && (
        <Header>
          <slot name="chip" slot="chip" />
        </Header>
      )
    }
    {header && <MobileMenu />}
    <slot />
    {header && <Footer />}
    {/* F12: UNA capa de grano fija para toda la página (antes una por sección). */}
    <div class="pb-grain pb-grain--page" aria-hidden="true"></div>
    <script>
      import { initFx } from '../scripts/fx';
      import { initLenis } from '../scripts/lenis';
      initFx();
      initLenis();
      // Panel de diagnóstico de fluidez: solo con ?diag (docs/SESSIONS.md). Nadie más descarga nada.
      if (new URLSearchParams(location.search).has('diag')) void import('../scripts/diag').then((m) => m.initDiag());
    </script>
  </body>
</html>
